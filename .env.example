# Postgres connection string. If using the included docker-compose.yml, this matches it exactly.
# For a hosted free-tier option, use Neon, Supabase, or Railway Postgres and paste their connection string here.
DATABASE_URL="postgresql://realestate:realestate@localhost:5432/realestate"

# Secret used to sign session JWTs. Generate your own, e.g.: openssl rand -base64 32
JWT_SECRET="your_jwt_secret_here"

# Stripe (DEMO MODE): leave unset to run the reservation flow in demo mode, which
# clearly labels itself and never contacts Stripe. To use real test payments,
# create a Stripe account, grab your TEST secret key (starts with sk_test_), and
# set it here. Never put a live (sk_live_) key in this project as shipped.
STRIPE_SECRET_KEY="your_stripe_test_secret_key_here"
