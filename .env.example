# Postgres connection string. If using the included docker-compose.yml, this matches it exactly.
# For a hosted free-tier option, use Neon, Supabase, or Railway Postgres and paste their connection string here.
DATABASE_URL="postgresql://realestate:realestate@localhost:5432/realestate"

# Secret used to sign session JWTs. Generate your own, e.g.: openssl rand -base64 32
JWT_SECRET="your_jwt_secret_here"
