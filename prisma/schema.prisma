// Real Estate & Reservation Management System — core schema
// NOTE: PostGIS geospatial indexing from the original spec is out of scope for this
// build (see README "What's stubbed"). latitude/longitude are stored as plain floats;
// swap in the `postgis` extension + a `geography` column later for radius/proximity search.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  AGENT
  BUYER_TENANT
  PROPERTY_OWNER
}

enum PropertyType {
  LAND
  HOUSE
  APARTMENT
  COMMERCIAL
  VILLA
}

enum PropertyListingStatus {
  DRAFT
  PENDING_APPROVAL
  AVAILABLE
  RESERVED
  SOLD
  RENTED
}

enum ReservationStatus {
  HOLD_PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  phone        String?       @unique
  passwordHash String
  role         Role          @default(BUYER_TENANT)
  isVerified   Boolean       @default(false)
  properties   Property[]    @relation("OwnerProperties")
  reservations Reservation[] @relation("BuyerReservations")
  reviews      Review[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Property {
  id             String                @id @default(uuid())
  title          String
  slug           String                @unique
  description    String
  type           PropertyType
  status         PropertyListingStatus @default(DRAFT)
  price          Decimal               @db.Decimal(12, 2)
  reservationFee Decimal               @db.Decimal(10, 2)
  address        String
  city           String
  country        String
  latitude       Float
  longitude      Float

  // Dynamic attributes: bedrooms, bathrooms, land area, zoning, etc.
  attributes Json

  images       PropertyImage[]
  documents    PropertyDocument[]
  ownerId      String
  owner        User               @relation("OwnerProperties", fields: [ownerId], references: [id])
  reservations Reservation[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([latitude, longitude])
  @@index([type, status])
  @@index([ownerId])
}

model PropertyImage {
  id         String   @id @default(uuid())
  url        String
  isPrimary  Boolean  @default(false)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model PropertyDocument {
  id         String   @id @default(uuid())
  title      String
  fileUrl    String
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Reservation {
  id             String            @id @default(uuid())
  propertyId     String
  property       Property          @relation(fields: [propertyId], references: [id])
  buyerId        String
  buyer          User              @relation("BuyerReservations", fields: [buyerId], references: [id])
  status         ReservationStatus @default(HOLD_PENDING_PAYMENT)
  holdExpiresAt  DateTime
  amountPaid     Decimal           @db.Decimal(10, 2)
  stripeIntentId String?           @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([propertyId])
  @@index([buyerId])
  @@index([status])
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
}
